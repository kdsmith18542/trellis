<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>trellis</ToolCommandName>
    <IsPackable>true</IsPackable>
    <PackageId>Trellis.CLI</PackageId>
    <Version>1.0.0</Version>
    <Description>CLI tool for Trellis blockchain development — init projects, generate keys, start nodes, and run dev networks.</Description>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Trellis.Core\Trellis.Core.fsproj" />
    <ProjectReference Include="..\Trellis.Node\Trellis.Node.fsproj" />
  </ItemGroup>

</Project>
