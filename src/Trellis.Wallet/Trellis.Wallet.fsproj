<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Trellis.Wallet</AssemblyName>
    <RootNamespace>Trellis.Wallet</RootNamespace>
    <UseAvalonia>true</UseAvalonia>
    <IsPackable>true</IsPackable>
    <PackageId>Trellis.Wallet</PackageId>
    <Version>1.0.0</Version>
    <Description>Avalonia desktop wallet for the Trellis blockchain. Cross-platform GUI for accounts, transactions, staking, and multi-sig.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.7" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.7" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.7" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.7" />
    <PackageReference Include="Avalonia.ReactiveUI" Version="11.3.7" />
    <PackageReference Include="ReactiveUI" Version="20.1.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Trellis.Core/Trellis.Core.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="SimpleAvaloniaWallet.fs" />
  </ItemGroup>


</Project>
